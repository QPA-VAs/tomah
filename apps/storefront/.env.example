# Public API root, including /api/v1. Required when TOMAH_API_MODE=live.
TOMAH_API_BASE_URL=https://api.tomah.com/api/v1
# Data source: mock for local/demo use, live for the admin team's public API.
TOMAH_API_MODE=mock
# Canonical public storefront origin used for metadata, sitemap and payment callbacks.
TOMAH_PUBLIC_SITE_URL=https://tomah.vercel.app

# Deployment URLs this project reverse-proxies under its own domain
# (see next.config.ts `rewrites()`): /admin/* -> admin dashboard,
# /api/* and /uploads/* -> admin API. Only needed if the deployed project
# aliases differ from the defaults baked into next.config.ts.
# TOMAH_ADMIN_ORIGIN=https://tomah-admin.vercel.app
# TOMAH_API_ORIGIN=https://tomah-api.vercel.app
